# ---------------------------------------------------------------------------
# Copy to .env and fill in. Everything here is optional except GEMINI_API_KEY,
# and that is only needed if you want to regenerate the photography.
# ---------------------------------------------------------------------------

# Image generation (npm run images). Not used at runtime.
GEMINI_API_KEY=""

# --- Lead capture -----------------------------------------------------------

# People who can claim free access per day. Resets at midnight in TIMEZONE.
DAILY_CAPACITY="20"
TIMEZONE="Asia/Kolkata"

# Where new leads get pushed the moment they come in. A Slack incoming webhook,
# a Zapier/Make catch hook, or your own endpoint. Leave blank to disable.
LEAD_WEBHOOK_URL=""

# Enables GET /api/admin/leads.csv. Without it the route returns 404.
#   curl -H "x-admin-token: YOUR_TOKEN" https://yoursite.com/api/admin/leads.csv -o leads.csv
ADMIN_TOKEN=""

# Salt for hashing visitor IPs. Set a fixed random string in production,
# otherwise it is regenerated on every restart and abuse tracking resets.
IP_SALT=""

# Abuse limits.
RATE_LIMIT_PER_HOUR="5"
MIN_FILL_SECONDS="2.5"

PORT="3000"

# --- Ad tracking ------------------------------------------------------------
# Build-time only (VITE_ prefixed vars are inlined into the client bundle).
# Set these before `npm run build` or no pixel fires.

VITE_META_PIXEL_ID=""
VITE_GA4_ID=""
VITE_GTM_ID=""
